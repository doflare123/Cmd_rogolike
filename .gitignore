# -----------------------------------------------------------------------------
# Godot 4
# -----------------------------------------------------------------------------
# Импортированные ресурсы, состояние редактора, сгенерированные сборки C# и кеш шейдеров.
.godot/

# Служебные файлы импорта Godot. Они заново создаются из исходных ресурсов.
*.import

# Отчёты о сбоях Mono.
mono_crash.*.json

# Шаблон сборки Android, установленный или созданный внутри проекта Godot.
/android/

# Локальные и экспортированные сборки. Сам export_presets.cfg при появлении сохраняем в Git.
/build/
/builds/
/dist/
/export/
/exports/

# -----------------------------------------------------------------------------
# .NET / MSBuild
# -----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
artifacts/
TestResults/
BenchmarkDotNet.Artifacts/

*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates
*.csproj.user

# Сгенерированные NuGet файлы и локальные каталоги пакетов.
packages/
*.nupkg
*.snupkg
project.assets.json
project.nuget.cache
*.nuget.g.props
*.nuget.g.targets

# Журналы сборки и промежуточные файлы компилятора.
*.binlog
*.buildlog
*.pdb
*.mdb
*.opendb
*.VC.db

# -----------------------------------------------------------------------------
# Среды разработки и редакторы
# -----------------------------------------------------------------------------
.vs/
.idea/
*.sln.iml

.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json

# Кеши ReSharper и Rider.
_ReSharper*/
*.DotSettings.user

# Данные профилирования и покрытия кода Visual Studio.
*.coverage
*.coveragexml
*.vsp
*.vspx
*.sap

# -----------------------------------------------------------------------------
# Метаданные операционных систем
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# Журналы, временные файлы, резервные копии и локальные кеши
# -----------------------------------------------------------------------------
*.log
logs/

*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
*.swp
*.swo
*~

.cache/
.tmp/
tmp/
temp/

# Локальное окружение и секреты. Вместо них сохраняем в Git файл-пример.
.env
.env.*
!.env.example

# -----------------------------------------------------------------------------
# Правила проекта
# -----------------------------------------------------------------------------
# Файл решения легко создаётся из CmdRoguelike.csproj и пока считается локальным
# вспомогательным файлом IDE. Это правило нужно удалить, если позднее появится
# общая конфигурация уровня решения.
/CmdRoguelike.sln
